# Copy to .env and fill in. docker compose reads it automatically.

# Required: at least 32 random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Public base URL used in invite links, e.g. https://arblab.example.com (default: taken from the request)
APP_URL=

# Host address and port to publish on. 127.0.0.1 keeps it behind a reverse proxy on this machine;
# use 0.0.0.0 to reach it directly from other devices on your network.
ARBLAB_BIND=127.0.0.1
ARBLAB_PORT=8080

# Cookies are HTTPS-only by default. Set to false only when serving plain HTTP to other devices
# (for example http://192.168.1.20:8080 on a home network). localhost works either way.
SECURE_COOKIES=
